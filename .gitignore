# Rust (target-*/ covers alternate build dirs used by spike experiments)
target/
target-*/

# Node tooling
node_modules/

# Flutter and Dart (spikes now, app later)
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/

# Spike outputs that are regenerated or large
spikes/**/out/
# Keep SoundFonts out of git by default, except the small bundled trimmed one
# (ADR-026; the full FluidR3 GM source must never be committed).
*.sf2
!assets/soundfonts/GuitarSteel.sf2

# The S1/S4 Flutter spike only runs on Windows. Unused platform template folders
# generated by `flutter create` are kept out of git (regenerate with `flutter create .`).
spikes/s1_s4_flutter/android/
spikes/s1_s4_flutter/ios/
spikes/s1_s4_flutter/macos/
spikes/s1_s4_flutter/linux/
spikes/s1_s4_flutter/web/

# OS
Thumbs.db
.DS_Store
