# Generated files (FF-12, ADR-005): frb codegen produces LF-only output. Force LF so
# `git diff --exit-code` passes on every platform regardless of core.autocrlf.
crates/mc-ffi/src/frb_generated.rs text eol=lf
packages/core_bridge/lib/src/generated/** text eol=lf

# Guitar Pro test files are binary (ADR-036): no line-ending conversion, no text diff.
*.gp3 binary
*.gp4 binary
*.gp5 binary
# Bundled Bravura (ADR-037): byte-exact files checked by SHA-256 (FF-35). No line-ending
# conversion, also for the text files Bravura.json and OFL.txt.
packages/ui_kit/fonts/bravura/** binary
